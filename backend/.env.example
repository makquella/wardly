USE_LLM=false
LLM_PROVIDER=disabled
LLM_TIMEOUT=6
LLM_MAX_TOKENS=350
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-oss-120b:free
# Google Gemini (AI Studio key, free Flash tier) - post-match AI coach only.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# The post-match AI coach uses the Gemini / Groq / OpenRouter key above when the
# player has not entered one in the launcher (dev only; USE_LLM is not needed for it).
LLAMACPP_BASE_URL=http://127.0.0.1:8080
LLAMACPP_MODEL=local-gpt-oss-20b

GSI_DEBUG_LOG=false

# Player history and post-match reviews (SQLite + OpenDota).
# PLAYER_DATA_DIR defaults to backend/player_data (installed app: %APPDATA%\DotaAICoach\player_data).
PLAYER_DATA_DIR=
OPENDOTA_ENABLED=true
OPENDOTA_API_URL=https://api.opendota.com/api
# Optional: raises the OpenDota rate limit; not needed for normal use.
OPENDOTA_API_KEY=
# Wardly's shared cache of OpenDota reference data (hero stats, items, per-hero timings), tried before OpenDota.
# Default: https://api.luhovyimvp.dev/v1/opendota ; an empty value switches it off (uncomment to change).
# WARDLY_OPENDOTA_CACHE_URL=https://api.luhovyimvp.dev/v1/opendota
